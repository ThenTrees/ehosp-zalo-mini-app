# Zalo Mini App CLI
APP_ID=
ZMP_TOKEN=

# API người bệnh của emr-api.
#
# Địa chỉ GỐC của hợp đồng §6, PHẢI kết thúc bằng /api/patient-app: client gọi
# <base>/link, <base>/me, <base>/visits… nên thiếu tiền tố này là 404 mọi tuyến.
#
# Chạy trên máy: http://127.0.0.1:3000/api/patient-app — đúng API_PORT mặc
# định của emr-api. Dùng 127.0.0.1 chứ KHÔNG dùng localhost: zmp bind ::1 còn
# Docker bind 127.0.0.1, nên "localhost" phân giải sang IPv6 trước và request
# đi ngược vào chính dev server, nhận về index.html thay vì JSON.
#
# "npm start" chạy "zmp start -P 3002", chiếm 3002 (khung Zalo) và 3001 (app
# thật, vì khung nhúng iframe trỏ tới port-1). Cả hai đều tránh 3000 của API.
#
# Deploy thật: https://<tên miền>/api/patient-app. Webview Zalo chặn HTTP, và
# tên miền phải được khai trong Mini App Center.
#
# Để trống và đặt VITE_USE_FAKE=true khi chưa có back-end.
VITE_API_BASE_URL=

# false = gọi API thật. true = tầng dữ liệu giả, không chạm mạng.
#
# CẢNH BÁO: "zmp deploy" đóng gói đúng giá trị đang có ở dòng dưới. Phát hành
# với true là phát hành dữ liệu bệnh nhân bịa cho người dùng thật.
#
# Ở false, màn liên kết gọi SDK getPhoneNumber() của Zalo — SDK này không chạy
# trong trình duyệt thường, và quyền số điện thoại phải được Zalo duyệt.
VITE_USE_FAKE=true

# Số điện thoại thay cho SDK Zalo khi phát triển trên trình duyệt.
# `getPhoneNumber()` của zmp-sdk chỉ chạy bên trong ứng dụng Zalo thật, nên trên
# trình duyệt không có cách nào đi trọn luồng liên kết với máy chủ THẬT. Đặt biến
# này thành một số CÓ THẬT trong `emr_patient_link` thì máy khách gửi thẳng số ấy
# làm mã, và máy chủ ở chế độ phát triển (thiếu ZALO_APP_SECRET, NODE_ENV khác
# production) coi chính nó LÀ số điện thoại — xem modules/patient-app/zalo.ts.
# Tầng dữ liệu VẪN THẬT: mọi tuyến, mọi dòng CSDL, mọi nhật ký đều thật.
# `readRuntimeConfig` BỎ QUA biến này ở bản dựng phát hành.
VITE_ZALO_PHONE_GIA=
