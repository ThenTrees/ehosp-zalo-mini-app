# Zalo Mini App CLI
APP_ID=
ZMP_TOKEN=

# API người bệnh của emr-api.
#
# Địa chỉ GỐC của hợp đồng §6, PHẢI kết thúc bằng /api/patient-app: client gọi
# <base>/link, <base>/me, <base>/visits… nên thiếu tiền tố này là 404 mọi tuyến.
#
# Chạy trên máy: http://localhost:3010/api/patient-app — cổng 3010 chứ không
# phải 3000, vì "zmp start" đã chiếm 3000, trùng API_PORT mặc định của emr-api.
#
# Deploy thật: https://<tên miền>/api/patient-app. Webview Zalo chặn HTTP, và
# tên miền phải được khai trong Mini App Center.
#
# Để trống và đặt VITE_USE_FAKE=true khi chưa có back-end.
VITE_API_BASE_URL=

# false = gọi API thật. true = tầng dữ liệu giả, không chạm mạng.
#
# CẢNH BÁO: "zmp deploy" đóng gói đúng giá trị đang có ở dòng dưới. Phát hành
# với true là phát hành dữ liệu bệnh nhân bịa cho người dùng thật.
#
# Ở false, màn liên kết gọi SDK getPhoneNumber() của Zalo — SDK này không chạy
# trong trình duyệt thường, và quyền số điện thoại phải được Zalo duyệt.
VITE_USE_FAKE=true
